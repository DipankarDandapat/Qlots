# Android emulator talking to the API on the host computer:
#EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Production builds must use the deployed API over HTTPS:
EXPO_PUBLIC_API_URL=https://one.qlots.in

# Set to true to enable full network request/response logging (debug only, never in production)
EXPO_PUBLIC_NETWORK_LOG=true
